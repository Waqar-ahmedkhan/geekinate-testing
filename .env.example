NEXT_PUBLIC_APP_URL=http://localhost:3007

# Contact form delivery, read by worker/contact.js. The first route configured wins; with neither set the endpoint answers
# 503 and the form falls back to its own panel with the address in it.
#
# CONTACT_WEBHOOK_URL posts the validated payload as JSON — n8n, Make, Zapier, a Slack hook, anything that takes a POST.
CONTACT_WEBHOOK_URL=
# Or Resend's REST API, which needs all three. CONTACT_FROM must be on a domain verified with Resend; the sender's own address goes
# out as reply_to rather than from, because a forged from header is what gets a domain's mail rejected.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# Referral delivery, read by worker/partner.js. Both are optional overrides — with neither set that route falls back to the
# CONTACT_* pair above, and with none of them set it answers 503 the same way.
PARTNER_WEBHOOK_URL=
PARTNER_TO=

# Model access for the Guide, read by worker/guide.js. Calls go straight to OpenAI. Unset, the endpoint answers 503 and the chat
# shows "The guide is not running right now." .env is gitignored and never reaches Cloudflare, so every key below NEXT_PUBLIC_APP_URL
# is a secret in the Worker's Settings > Variables and Secrets. NEXT_PUBLIC_APP_URL itself is a build variable under Settings > Build.
#
# There is no provider-side spend ceiling on this path. Set a monthly budget and a hard limit in the OpenAI dashboard under
# Settings > Limits, or the only cost controls are maxOutputTokens, the input caps and the route's own throttle.
OPENAI_API_KEY=
# Salt for the hash that identifies a visitor to the throttle and to OpenAI's abuse tracking, so a raw IP is never sent onward.
# Any long random string. Changing it resets everyone's bucket.
AI_USER_SALT=
