NEXT_PUBLIC_APP_URL=http://localhost:3007

# Contact form delivery, read by app/api/contact/route.js. The first route configured wins; with neither set the endpoint answers
# 503 and the form falls back to its own panel with the address in it.
#
# CONTACT_WEBHOOK_URL posts the validated payload as JSON — n8n, Make, Zapier, a Slack hook, anything that takes a POST.
CONTACT_WEBHOOK_URL=
# Or Resend's REST API, which needs all three. CONTACT_FROM must be on a domain verified with Resend; the sender's own address goes
# out as reply_to rather than from, because a forged from header is what gets a domain's mail rejected.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# Referral delivery, read by app/api/partner/route.js. Both are optional overrides — with neither set that route falls back to the
# CONTACT_* pair above, and with none of them set it answers 503 the same way.
PARTNER_WEBHOOK_URL=
PARTNER_TO=

# Blueprint delivery, read by app/api/blueprint/email/route.js. Same fallback chain: these first, then the CONTACT_* pair.
BLUEPRINT_WEBHOOK_URL=
BLUEPRINT_TO=

# Model access for the Blueprint, read by app/api/blueprint/route.js. Requests go through Vercel AI Gateway, which is a plain HTTPS
# API and does not require the site to be hosted on Vercel. Unset, the endpoint answers 503 and the section shows its own panel.
#
# The spend ceiling, the per-user rate limits and the response cache are configured in the Gateway dashboard, not here. Until they
# are set, maxOutputTokens and the route's own throttle are the only cost controls that exist.
AI_GATEWAY_API_KEY=
# Salt for the hash that buckets a visitor for per-user rate limiting, so a raw IP is never sent to the gateway as an identifier.
# Any long random string. Changing it resets everyone's bucket.
AI_USER_SALT=
