# NEXT_PUBLIC_APP_URL is a build variable on Cloudflare (Settings > Build). .env is gitignored and never reaches Cloudflare, so
# every key below it is a secret in the Worker's Settings > Variables and Secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3007

# Contact form delivery, read by worker/contact.js. The first route configured wins; with neither set the endpoint answers
# 503 and the form falls back to its own panel with the address in it.
#
# CONTACT_WEBHOOK_URL posts the validated payload as JSON — n8n, Make, Zapier, a Slack hook, anything that takes a POST.
CONTACT_WEBHOOK_URL=
# Otherwise worker/mailer.js sends mail from CONTACT_FROM ("Name <address>") to CONTACT_TO. The visitor's own address goes out as
# reply_to rather than from, because a forged from header is what gets a domain's mail rejected.
CONTACT_FROM=
CONTACT_TO=
# With all three SMTP values set it signs in to that server on port 587 (smtp.gmail.com with an app password, or smtp.migadu.com),
# and CONTACT_FROM must be that mailbox's own address.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# Without them it uses Resend's REST API, and CONTACT_FROM must be on a domain verified with Resend.
RESEND_API_KEY=

# Referral delivery, read by worker/partner.js. Both are optional overrides — with neither set that route falls back to the
# CONTACT_* pair above, and with none of them set it answers 503 the same way.
PARTNER_WEBHOOK_URL=
PARTNER_TO=

