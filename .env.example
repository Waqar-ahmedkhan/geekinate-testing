NEXT_PUBLIC_APP_URL=http://localhost:3007

# Contact form delivery, read by app/api/contact/route.js. The first route configured wins; with neither set the endpoint answers
# 503 and the form falls back to its own panel with the address in it.
#
# CONTACT_WEBHOOK_URL posts the validated payload as JSON — n8n, Make, Zapier, a Slack hook, anything that takes a POST.
CONTACT_WEBHOOK_URL=
# Or Resend's REST API, which needs all three. CONTACT_FROM must be on a domain verified with Resend; the sender's own address goes
# out as reply_to rather than from, because a forged from header is what gets a domain's mail rejected.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
